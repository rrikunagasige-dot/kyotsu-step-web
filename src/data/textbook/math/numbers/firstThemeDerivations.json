{
  "n01": {
    "n01-04": {
      "before": [
        {
          "text": "yを一つ残し、他の因子を前へまとめる。yの指数が書かれていないときは1である。",
          "math": "5x^3y=(5x^3)y^1"
        }
      ]
    },
    "n01-r3-q07-x2coef": {
      "before": [
        {
          "text": "同じx²を一つ外へ出す。3と−5が、そのまま括弧内へ残る。",
          "math": "3x^2-5x^2=(3+(-5))x^2=(3-5)x^2"
        }
      ]
    },
    "n01-r3-q07-xcoef": {
      "before": [
        {
          "text": "一次項も同じ操作を行う。xを掛ける前の数だけを足す。",
          "math": "-5x+2x=(-5+2)x"
        }
      ]
    },
    "n01-09a": {
      "before": [
        {
          "text": "省略されている係数を補い、符号ごと読み取る。",
          "math": "x^3=1\\cdot x^3\\quad;\\quad -x^3=(-1)x^3"
        },
        {
          "text": "三次の二項、一次の二項は、それぞれ共通する文字の部分を残す。",
          "math": "x^3-x^3=(1-1)x^3\\quad;\\quad x+3x=(1+3)x"
        }
      ]
    },
    "n01-bridge-audit-cancel-cube": {
      "after": [
        {
          "text": "係数0の項は値が0なので、式から取り除ける。",
          "math": "0x^3=0"
        }
      ]
    },
    "n01-09b": {
      "assemble": [
        {
          "text": "計算した二つの係数を、元の位置へ戻す。ここから値0の項を消して整理する。",
          "math": "(1-1)x^3-2x^2+(1+3)x-1=0x^3-2x^2+4x-1"
        }
      ]
    }
  },
  "n02": {
    "n02-04": {
      "before": [
        {
          "text": "元の式の項を、二次・一次・xを含まない部分へ並べ替える。項の符号は変えない。",
          "math": "x^2+2xy+y^2-3x-3y+2=x^2+(2xy-3x)+(y^2-3y+2)"
        },
        {
          "text": "一次の二項にあるxを外へ出す。これは直前に求めた一次係数の使い道である。",
          "math": "2xy-3x=(2y)x-3x=(2y-3)x"
        }
      ]
    },
    "n02-10": {
      "assemble": [
        {
          "text": "Bの一次係数は0。係数倍した後も一次項は増えないため、一次の計算は次のようになる。",
          "math": "2x+0x=(2+0)x=2x"
        }
      ]
    },
    "n02-bridge-group-coefficients": {
      "after": [
        {
          "text": "括弧を外した結果を、Aの二項とBの二項へ並べ替えた。",
          "math": "3A-4B-A+B=(3A-A)+(-4B+B)"
        }
      ]
    }
  },
  "n03": {
    "n03-03": {
      "before": [
        {
          "text": "aをm個掛けた組がn組ある形へ戻す。",
          "math": "(a^m)^n=\\underbrace{a^m\\cdot a^m\\cdots a^m}_{n\\text{組}}"
        }
      ]
    },
    "n03-04": {
      "before": [
        {
          "text": "まず三組の場合を、実際に並べ替えて確かめる。aとbをそれぞれ同じ種類で集める。",
          "math": "(ab)^3=(ab)(ab)(ab)=a\\cdot a\\cdot a\\cdot b\\cdot b\\cdot b"
        }
      ]
    },
    "n03-05": {
      "before": [
        {
          "text": "三乗を同じ三つの因子の積へ戻す。次に、係数・xの組・yの組ごとに集める。",
          "math": "(-2x^3y^2)^3=(-2x^3y^2)(-2x^3y^2)(-2x^3y^2)"
        }
      ]
    },
    "n03-bridge-negative-cube": {
      "assemble": [
        {
          "text": "最初の二個の積4を、残る−2へ掛ける段階まで戻す。",
          "math": "(-2)^3=4(-2)"
        }
      ]
    },
    "n03-bridge-x-power": {
      "before": [
        {
          "text": "三つの組を続けて書くと、指数を足す関係へ戻せる。",
          "math": "(x^3)^3=x^3x^3x^3=x^{3+3+3}"
        }
      ]
    },
    "n03-12": {
      "before": [
        {
          "text": "後ろの括弧をDと呼べば、前の二項を配る操作が見える。ここだけDは2x²−x+5を表す。",
          "math": "(3x-1)D=3xD-D"
        }
      ]
    },
    "n03-bridge-second-row": {
      "before": [
        {
          "text": "−1を各項へ配る。最初と最後の積も符号ごと計算する。",
          "math": "(-1)(2x^2)=-2x^2\\quad;\\quad(-1)5=-5"
        }
      ]
    }
  },
  "n04": {
    "n04-q01-p1": {
      "before": [
        {
          "text": "係数5を二回掛け、xも二回掛ける。",
          "math": "(5x)(5x)=(5\\cdot5)x^{1+1}"
        }
      ]
    },
    "n04-q01-p2": {
      "before": [
        {
          "text": "5xと4yの積では、数の部分と文字の部分を別に集める。",
          "math": "(5x)(4y)=(5\\cdot4)xy"
        }
      ]
    },
    "n04-q01-p3": {
      "before": [
        {
          "text": "逆の交差積も、一つの独立した組として数える。",
          "math": "(4y)(5x)=(4\\cdot5)yx"
        }
      ]
    },
    "n04-q01-p4": {
      "before": [
        {
          "text": "最後の平方でも、係数と文字の両方が二回掛かる。",
          "math": "(4y)(4y)=(4\\cdot4)y^{1+1}"
        }
      ]
    },
    "n04-02": {
      "before": [
        {
          "text": "文字xyが同じなので、係数だけを足す形へ戻す。",
          "math": "20xy+20xy=(20+20)xy"
        }
      ]
    },
    "n04-04": {
      "before": [
        {
          "text": "具体例と同じ四組の積を、aとbでも一回ずつ作る。",
          "math": "a\\cdot a=a^2\\quad;\\quad a\\cdot b=ab"
        },
        {
          "text": "残る二組も別に数える。交換法則を使ってまとめるのは、その後にする。",
          "math": "b\\cdot a=ba\\quad;\\quad b\\cdot b=b^2"
        }
      ]
    },
    "n04-06": {
      "assemble": [
        {
          "text": "もう一方の交差積も−abとなる。四つの積を元の順序で並べる。",
          "math": "(-b)a=-ab"
        }
      ]
    },
    "n04-08": {
      "before": [
        {
          "text": "和と差の積を二行へ分配し、平方と交差積を分ける。",
          "math": "(a+b)(a-b)=a(a-b)+b(a-b)"
        },
        {
          "text": "二つの行を開くと、符号が反対の交差積が現れる。",
          "math": "a(a-b)=a^2-ab\\quad;\\quad b(a-b)=ab-b^2"
        }
      ]
    },
    "n04-bridge-audit-opposite-cancel": {
      "after": [
        {
          "text": "係数0の交差項は値0となり、両端の平方だけが残る。",
          "math": "0ab=0"
        }
      ]
    },
    "n04-10": {
      "assemble": [
        {
          "text": "定数の平方も別に計算し、それぞれの公式へ戻す。",
          "math": "5^2=5\\cdot5=25\\quad;\\quad2^2=2\\cdot2=4"
        }
      ],
      "before": [
        {
          "text": "二つ目は和と差の積である。対応する式3x、2を、平方差へそのまま入れる。",
          "math": "(3x-2)(3x+2)=(3x)^2-2^2"
        }
      ]
    },
    "n04-11": {
      "before": [
        {
          "text": "最初の項を、後ろの二項へ一つずつ掛ける。",
          "math": "(ax)(cx)=acx^2\\quad;\\quad(ax)d=adx"
        },
        {
          "text": "前の定数bから生まれる二組も加える。",
          "math": "b(cx)=bcx\\quad;\\quad bd=bd"
        }
      ]
    },
    "n04-13": {
      "assemble": [
        {
          "text": "最初どうしと最後どうしの積を戻す。一次項だけを足した結果と合わせれば全体の展開になる。",
          "math": "(3x)x=3x^2\\quad;\\quad1\\cdot2=2"
        }
      ]
    },
    "n04-14": {
      "before": [
        {
          "text": "二つの同じ括弧を四組へ開く。交差積を残してから同類項をまとめる。",
          "math": "(T+c)^2=(T+c)(T+c)=T^2+Tc+cT+c^2"
        },
        {
          "text": "中央の二項は同じTcなので、係数を足す形へ直せる。",
          "math": "Tc+cT=(1+1)Tc"
        }
      ]
    },
    "n04-bridge-expand-restored": {
      "before": [
        {
          "text": "戻した平方には既習の和の平方を使う。",
          "math": "(a+b)^2=a^2+2ab+b^2"
        },
        {
          "text": "もう一方の括弧へは2cを分配する。",
          "math": "2(a+b)c=2ac+2bc"
        }
      ]
    },
    "n04-16": {
      "before": [
        {
          "text": "三項の平方のcを、出てくる全ての場所で−cへ置き換える。まず負号を計算せずに残す。",
          "math": "(a+b-c)^2=a^2+b^2+(-c)^2+2ab+2a(-c)+2b(-c)"
        }
      ],
      "assemble": [
        {
          "text": "cの平方では負号が二回掛かるため正になる。三つの計算結果を元の位置へ戻す。",
          "math": "(-c)^2=c^2"
        }
      ]
    },
    "n04-18": {
      "before": [
        {
          "text": "直前に見つけた共通部分をA=x²+1、符号が反対の部分をB=xと呼ぶ。使う関係を先に書く。",
          "math": "(A+B)(A-B)=A^2-B^2"
        }
      ]
    },
    "n04-19": {
      "before": [
        {
          "text": "残る平方を開き、外側の−x²を最後まで残す。",
          "math": "(x^2+1)^2-x^2=x^4+2x^2+1-x^2"
        }
      ]
    },
    "n04-bridge-pairing": {
      "before": [
        {
          "text": "各組の一次係数は定数の和となる。候補の二つの和を、実際に計算して比べる。",
          "math": "(1+2,\\,3+4)=(3,7)"
        },
        {
          "text": "別の組み方でも、二つの一次係数はまだ一致しない。",
          "math": "(1+3,\\,2+4)=(4,6)"
        },
        {
          "text": "最後の組み方では、二つの和が一致する。次はそれを実際の因数の組として選ぶ。",
          "math": "(1+4,\\,2+3)=(5,5)"
        }
      ]
    },
    "n04-bridge-pair-first": {
      "before": [
        {
          "text": "選んだ一組目を四項へ展開し、一次項だけを集める。",
          "math": "(x+1)(x+4)=x^2+4x+x+4=x^2+(4+1)x+4"
        }
      ]
    },
    "n04-bridge-pair-second": {
      "before": [
        {
          "text": "二組目も同じ手順で展開する。",
          "math": "(x+2)(x+3)=x^2+3x+2x+6=x^2+(3+2)x+6"
        }
      ]
    },
    "n04-21": {
      "before": [
        {
          "text": "Tの式を四組の積へ開き、一次項をまとめる。",
          "math": "(T+4)(T+6)=T^2+6T+4T+24=T^2+(6+4)T+24"
        }
      ]
    },
    "n04-bridge-restore-square": {
      "assemble": [
        {
          "text": "最初の項も二乗する。交差積と最後の平方は、先ほど別々に計算した結果を戻す。",
          "math": "(x^2)^2=x^{2\\cdot2}=x^4"
        }
      ]
    },
    "n04-bridge-restore-ten": {
      "before": [
        {
          "text": "10は括弧内の二つの項へ同じように掛かる。",
          "math": "10(x^2+5x)=10x^2+10(5x)"
        }
      ]
    },
    "n04-17": {
      "after": [
        {
          "text": "選んだ共通部分が両方に現れるよう、実際に項の順をそろえる。",
          "math": "x^2+x+1=(x^2+1)+x\\quad;\\quad x^2-x+1=(x^2+1)-x"
        }
      ]
    },
    "n04-22": {
      "assemble": [
        {
          "text": "平方と10倍をそれぞれ計算した結果を、一つの式へ戻す。二次項の係数だけを最後に足す。",
          "math": "(x^2+5x)^2+10(x^2+5x)+24=x^4+10x^3+(25+10)x^2+50x+24"
        }
      ]
    }
  },
  "n05": {
    "n05-03": {
      "before": [
        {
          "text": "二つの括弧の各項を掛け、まだ定数の積を残す。",
          "math": "(x-3)(y+5)=xy+5x+(-3)y+(-3)5"
        }
      ]
    },
    "n05-04": {
      "after": [
        {
          "text": "括弧全体へ−1を配ると、引き算の順を反対にした式になる。",
          "math": "-(a-b)=-a+b=b-a"
        }
      ]
    },
    "n05-05": {
      "before": [
        {
          "text": "直前に得たb−a=−(a−b)を、二項目だけへ代入する。",
          "math": "(a-b)x+(b-a)y=(a-b)x-(a-b)y"
        }
      ]
    },
    "n05-06": {
      "assemble": [
        {
          "text": "数の平方へ、それぞれ文字の平方を掛け直す。",
          "math": "16x^2=4^2x^2\\quad;\\quad9y^2=3^2y^2"
        }
      ]
    },
    "n05-07": {
      "before": [
        {
          "text": "候補の中央は同じ交差積が二組ある。数の係数を前へ集める。",
          "math": "2(4x)(3y)=(2\\cdot4\\cdot3)xy=(8\\cdot3)xy"
        }
      ]
    },
    "n05-09": {
      "before": [
        {
          "text": "二つの一次式を四組の積へ開く。",
          "math": "(a+r)(a+s)=a^2+as+ra+rs"
        },
        {
          "text": "一次項に共通するaを外へ出す。",
          "math": "as+ra=(s+r)a=(r+s)a"
        }
      ]
    },
    "n05-bridge-audit-factor-pair-select": {
      "after": [
        {
          "text": "選んだ組を二条件へ代入して検算する。",
          "math": "(-8)+2=-6\\quad;\\quad(-8)2=-16"
        }
      ]
    },
    "n05-12": {
      "before": [
        {
          "text": "前のpxから二組、前のqから二組を作る。",
          "math": "(px)(rx)=prx^2\\quad;\\quad(px)s=psx"
        },
        {
          "text": "残る二組を加え、一次項だけを共通のxでくくる。",
          "math": "q(rx)=qrx\\quad;\\quad psx+qrx=(ps+qr)x"
        }
      ]
    },
    "n05-16": {
      "before": [
        {
          "text": "候補の積を、二次・一次・定数の係数が見える形まで展開する。",
          "math": "(x+r)(5x+s)=5x^2+sx+5rx+rs"
        },
        {
          "text": "一次項をまとめると、和ではなくs+5rが条件になる理由が分かる。",
          "math": "sx+5rx=(s+5r)x"
        },
        {
          "text": "まとめた一次項を二次項と定数項の間へ戻す。この式と元の三係数を比べる。",
          "math": "(x+r)(5x+s)=5x^2+(s+5r)x+rs"
        }
      ]
    },
    "n05-bridge-detail-substitute-r": {
      "after": [
        {
          "text": "二番目には、同じ組で求めたs=3を戻す。",
          "math": "5x+s=5x+3"
        }
      ]
    },
    "n05-19": {
      "before": [
        {
          "text": "一項目は3bを因子としてそのまま取り出せる。二項目にも同じ3bを作る。",
          "math": "3a^2b=(3b)a^2"
        }
      ]
    },
    "n05-bridge-audit-square-root-four": {
      "after": [
        {
          "text": "これで括弧の中を平方差へ直せる。外にある3bは残す。",
          "math": "a^2-4b^2=a^2-(2b)^2"
        },
        {
          "text": "外にくくった3bも、変形の前後で残してつなぐ。",
          "math": "3b(a^2-4b^2)=3b(a^2-(2b)^2)"
        }
      ]
    }
  },
  "n06": {
    "n06-01": {
      "after": [
        {
          "text": "同じXを、元の二つの括弧へそれぞれ対応させる。",
          "math": "x+2y+1=X+1\\quad;\\quad x+2y-2=X-2"
        }
      ]
    },
    "n06-bridge-x-expand": {
      "before": [
        {
          "text": "前のXと1を、後ろの括弧全体へ配る。外の−4も残す。",
          "math": "(X+1)(X-2)-4=X(X-2)+1(X-2)-4"
        }
      ]
    },
    "n06-bridge-x-pair": {
      "after": [
        {
          "text": "選んだ組が、係数から得た二条件を満たすことを代入で確認する。",
          "math": "(-3)+2=-1\\quad;\\quad(-3)2=-6"
        }
      ]
    },
    "n06-05": {
      "after": [
        {
          "text": "T=x²を、それぞれの次数の項へ対応させる。",
          "math": "x^4=(x^2)^2=T^2\\quad;\\quad-5x^2=-5T"
        }
      ]
    },
    "n06-bridge-t-pair": {
      "after": [
        {
          "text": "選んだ二数で、和と積の条件をもう一度照合する。",
          "math": "(-1)+(-4)=-5\\quad;\\quad(-1)(-4)=4"
        }
      ]
    },
    "n06-09": {
      "before": [
        {
          "text": "yを含む三項を前へ集め、yを含まない残りの項と分ける。",
          "math": "x^3+x^2y+x^2+xy-2x-2y=(x^2y+xy-2y)+(x^3+x^2-2x)"
        }
      ]
    },
    "n06-10": {
      "before": [
        {
          "text": "後半も、一項ずつxが掛かる形へ戻す。",
          "math": "x^3=x\\cdot x^2\\quad;\\quad x^2=x\\cdot x\\quad;\\quad-2x=x(-2)"
        }
      ]
    },
    "n06-bridge-last-pair": {
      "after": [
        {
          "text": "二数が二条件に一致することを確かめ、二次因子だけを分解する。",
          "math": "2+(-1)=1\\quad;\\quad2(-1)=-2"
        },
        {
          "text": "外のx+yを残し、この積を元の場所へ戻す。",
          "math": "x^2+x-2=(x+2)(x-1)"
        }
      ]
    },
    "n06-13": {
      "before": [
        {
          "text": "xの一次項を一つに集め、それ以外を定数部分として残す。",
          "math": "x^2+3xy+2y^2-x-3y-2=x^2+(3xy-x)+(2y^2-3y-2)"
        }
      ]
    },
    "n06-14": {
      "before": [
        {
          "text": "候補を(2y+r)(y+s)と書く。r,sはこれから求める定数であり、展開して条件を作る。",
          "math": "(2y+r)(y+s)=2y^2+(2s+r)y+rs"
        },
        {
          "text": "元の式2y²−3y−2と比べると、中央と定数から二条件が得られる。",
          "math": "2s+r=-3\\quad;\\quad rs=-2"
        }
      ]
    },
    "n06-bridge-audit-constant-pair": {
      "before": [
        {
          "text": "積が−2となる四候補について、一次係数2s+rも実際に計算して比較する。r=1、s=−2の場合。",
          "math": "2(-2)+1=-4+1=-3\\quad;\\quad1(-2)=-2"
        },
        {
          "text": "r=−1、s=2の場合。",
          "math": "2\\cdot2+(-1)=4-1=3\\quad;\\quad(-1)2=-2"
        },
        {
          "text": "r=2、s=−1の場合。",
          "math": "2(-1)+2=-2+2=0\\quad;\\quad2(-1)=-2"
        },
        {
          "text": "r=−2、s=1の場合。",
          "math": "2\\cdot1+(-2)=2-2=0\\quad;\\quad(-2)1=-2"
        }
      ]
    },
    "n06-16": {
      "before": [
        {
          "text": "定数部分は積、一次係数はその二因子の和として求まった。それぞれをxの二次式へ戻す。",
          "math": "x^2+(3y-1)x+(2y^2-3y-2)=x^2+((2y+1)+(y-2))x+(2y+1)(y-2)"
        }
      ]
    },
    "n06-11": {
      "after": [
        {
          "text": "共通因数を一度だけ外へ出し、残る係数の和を括弧へ入れた。",
          "math": "y(x^2+x-2)+x(x^2+x-2)=(y+x)(x^2+x-2)"
        }
      ]
    },
    "n06-15": {
      "before": [
        {
          "text": "和を、yの項と定数の二組へ並べ替える。次にこの二組を別々に計算する。",
          "math": "(2y+1)+(y-2)=(2y+y)+(1-2)"
        }
      ]
    }
  },
  "ne01": {
    "ne01-01": {
      "before": [
        {
          "text": "同じ三因子のうち二つを平方として先に計算する。",
          "math": "(x+3)^3=(x+3)(x+3)^2"
        },
        {
          "text": "和の平方へxと3を代入し、中央と最後の数も計算する。",
          "math": "(x+3)^2=x^2+2x\\cdot3+3^2=x^2+6x+9"
        }
      ]
    },
    "ne01-bridge-concrete-first": {
      "before": [
        {
          "text": "xを三項へ掛け、各文字の指数を計算する。",
          "math": "x\\cdot x^2=x^3\\quad;\\quad x\\cdot6x=6x^2\\quad;\\quad x\\cdot9=9x"
        }
      ]
    },
    "ne01-bridge-concrete-second": {
      "before": [
        {
          "text": "3を三項へ掛け、数の積を別々に計算する。",
          "math": "3\\cdot x^2=3x^2\\quad;\\quad3\\cdot6x=18x\\quad;\\quad3\\cdot9=27"
        }
      ]
    },
    "ne01-03": {
      "before": [
        {
          "text": "文字が一般のa,bになっても、二因子を平方へまとめる方法は同じである。",
          "math": "(a+b)^3=(a+b)(a+b)^2"
        }
      ]
    },
    "ne01-bridge-general-a": {
      "before": [
        {
          "text": "aを三項へ配り、同じ文字の指数だけを足す。",
          "math": "a\\cdot a^2=a^3\\quad;\\quad a(2ab)=2a^2b\\quad;\\quad ab^2=ab^2"
        }
      ]
    },
    "ne01-bridge-general-b": {
      "before": [
        {
          "text": "bを配った行も別に作る。中央の2はそのまま残る。",
          "math": "ba^2=a^2b\\quad;\\quad b(2ab)=2ab^2\\quad;\\quad bb^2=b^3"
        }
      ]
    },
    "ne01-06": {
      "assemble": [
        {
          "text": "負号を計算した各部分を、置換直後の三つの位置へ戻す。",
          "math": "3a^2(-b)=-3a^2b\\quad;\\quad3a(-b)^2=3ab^2\\quad;\\quad(-b)^3=-b^3"
        }
      ]
    },
    "ne01-08": {
      "before": [
        {
          "text": "既知の和の三乗から、余分な中央二項を両辺で引く。",
          "math": "(a+b)^3-3a^2b-3ab^2=a^3+b^3"
        },
        {
          "text": "引く二項をそれぞれ共通因数の積へ戻す。",
          "math": "3a^2b=(3ab)a\\quad;\\quad3ab^2=(3ab)b"
        }
      ],
      "after": [
        {
          "text": "二項を引く部分を一つの括弧へまとめ、その中へ因数分解の結果を戻す。",
          "math": "a^3+b^3=(a+b)^3-(3a^2b+3ab^2)=(a+b)^3-3ab(a+b)"
        }
      ]
    },
    "ne01-09": {
      "before": [
        {
          "text": "三乗から一つのa+bを外へ出す。もう一方の項にも同じ括弧が掛かる。",
          "math": "(a+b)^3=(a+b)(a+b)^2"
        },
        {
          "text": "これで二項の共通因数としてa+bを取り出せる。",
          "math": "a^3+b^3=(a+b)(a+b)^2-3ab(a+b)"
        }
      ]
    },
    "ne01-10": {
      "before": [
        {
          "text": "残る括弧の平方を展開し、−3abを残す。",
          "math": "(a+b)^2-3ab=a^2+2ab+b^2-3ab"
        }
      ]
    },
    "ne01-11": {
      "assemble": [
        {
          "text": "代入した二次因子の負号を、項ごとに処理する。",
          "math": "-a(-b)=ab\\quad;\\quad(-b)^2=b^2"
        }
      ]
    },
    "ne01-bridge-audit-cube-root-eight": {
      "after": [
        {
          "text": "係数の三乗と文字の三乗を別に計算して検算する。",
          "math": "(2x)^3=2^3x^3=8x^3"
        }
      ]
    },
    "ne01-bridge-audit-cube-root-twentyseven": {
      "after": [
        {
          "text": "二問目も係数の三乗を含めて一致した。",
          "math": "(3y)^3=3^3y^3=27y^3"
        }
      ]
    },
    "ne01-02": {
      "assemble": [
        {
          "text": "二つの行の結果を足し、二次項と一次項の組を作る。ここで求めた二つの係数を、この位置へ戻す。",
          "math": "(x+3)(x^2+6x+9)=x^3+(6x^2+3x^2)+(9x+18x)+27"
        }
      ]
    }
  }
}
