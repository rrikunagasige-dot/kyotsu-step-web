    "N07-Q11": {
      "assumptions": [
        "k positive integer",
        "reduce rational before considering denominator factors"
      ],
      "proof": [
        "10^k=(2*5)^k=2^k*5^k.",
        "A finite decimal is c/10^k, and reducing it divides its denominator by an integer common divisor, introducing no new prime.",
        "Conversely, let reduced denominator be2^u*5^v, u,v>=0.",
        "Choose h=max(u,v), so h-u,h-v>=0.",
        "Multiply numerator and denominator by2^(h-u)*5^(h-v).",
        "The resulting denominator is2^h*5^h=10^h; the numerator remains an integer.",
        "For denominator1 the number is already an integer."
      ],
      "conclusion": "A reduced positive denominator has only prime factors2 and5 iff the rational has a terminating decimal.",
      "proofStatus": "SOURCE_AND_REASONING_REVIEWED; not formally verified"
    },
