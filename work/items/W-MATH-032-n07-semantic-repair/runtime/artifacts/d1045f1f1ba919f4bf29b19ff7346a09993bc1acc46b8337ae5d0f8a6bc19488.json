\\sqrt{5 + 2\\sqrt{6}}"}],"mathStructures":[{"fractions":0,"radicals":2,"sha256":"354d10adfe29fa8b7f33ffffc5510889d426c0f7fb13085da824f5df295947a8","superscripts":0}],"text":" を簡単にしよう。根号の中にさらに根号があるため、2重根号という。"},{"extractionStatus":"PASS","id":"word-p-000665","images":[],"kind":"explanation","locator":"word/document.xml:p[665]","markers":[],"math":[],"mathStructures":[],"text":"先生　「平方したら根号の中と同じになる、非負の式を探します。平方根を含む二項の和を2乗したとき、どんな形になりましたか。」"},{"extractionStatus":"PASS","id":"word-p-000666","images":[],"kind":"question","locator":"word/document.xml:p[666]","markers":[1],"math":[{"display":"InlineMath","latex":"a > 0,b > 0"},{"display":"InlineMath","latex":"\\left( \\sqrt{a} + \\sqrt{b} \\right)^{2}"}],"mathStructures":[{"fractions":0,"radicals":0,"sha256":"bb8abffed91ca9a141e6f7a1543665e643ec10fa9c37ed58081e5d78a7d6196a","superscripts":0},{"fractions":0,"radicals":2,"sha256":"79d22b987e98cf79d0fba524eb42fa55885eead5c6e6495d55770043c25d982f","superscripts":1}],"text":"【1】  として、 を展開しよう。［　　　　　　　　　　　　　　　　］"},{"extractionStatus":"PASS","id":"word-p-000667","images":[],"kind":"question","locator":"word/document.xml:p[667]","markers":[2],"math":[{"display":"InlineMath","latex":"5 + 2\\sqrt{6}"},{"display":"InlineMath","latex":"a,b"}],"mathStructures":[{"fractions":0,"radicals":1,"sha256":"36404dfd5a70759aff4adb3e592a75537a7084483ce7035f0761b683b316b2e7","superscripts":0},{"fractions":0,"radicals":0,"sha256":"fb30c9a7a60ba28116aa81da48be604d2f46b3dfcff82844352a1187ca744874","superscripts":0}],"text":"【2】 根号内の  と比べ、 が満たす和と積の条件を書こう。［　　　　　　　　　　　　　　　　］"},{"extractionStatus":"PASS","id":"word-p-000668","images":[],"kind":"question","locator":"word/document.xml:p[668]","markers":[3],"math":[],"mathStructures":[],"text":"【3】 条件を満たす正の二数を探そう。［　　　　　　　　　　　　　　　　］"},{"extractionStatus":"PASS","id":"word-p-000669","images":[],"kind":"question","locator":"word/document.xml:p[669]","markers":[4],"math":[],"mathStructures":[],"text":"【4】 候補が非負であることも確認し、元の根号の値を答えよう。［　　　　　　　　　　　　　　　　］"},{"extractionStatus":"PASS","id":"word-p-000670","images":[],"kind":"explanation","locator":"word/document.xml:p[670]","markers":[],"math":[],"mathStructures":[],"text":"例題"},{"extractionStatus":"PASS","id":"word-p-000671","images":[],"kind":"explanation","locator":"word/document.xml:p[671]","markers":[],"math":[{"display":"InlineMath","latex":"\\sqrt{9 - 4\\sqrt{5}}"}],"mathStructures":[{"fractions":0,"radicals":2,"sha256":"28b9e73daf796d4ddcbc6cfd0eabd5999d82f72767c457e855bc0e128ce81bec","superscripts":0}],"text":" を簡単にしよう。今度は中央の項が負なので、平方根の差の平方を考える。"},{"extractionStatus":"PASS","id":"word-p-000672","images":[],"kind":"question","locator":"word/document.xml:p[672]","markers":[5],"math":[{"display":"InlineMath","latex":"\\left( \\sqrt{a} - \\sqrt{b} \\right)^{2}"}],"mathStructures":[{"fractions":0,"radicals":2,"sha256":"43ff1b5dcf77131c7cb48d59e4caf87663b5b28bd23ca39971ae7b2245a7ecfb","superscripts":1}],"text":"【5】  を展開しよう。［　　　　　　　　　　　　　　　　］"},{"extractionStatus":"PASS","id":"word-p-000673","images":[],"kind":"question","locator":"word/document.xml:p[673]","markers":[6],"math":[{"display":"InlineMath","latex":"4\\sqrt{5}"},{"display":"InlineMath","latex":"2\\sqrt{ab}"}],"mathStructures":[{"fractions":0,"radicals":1,"sha256":"533ec15ac822eb857242d8c3f2efd537153c6cbc5c57af360cd74a06724b4f7c","superscripts":0},{"fractions":0,"radicals":1,"sha256":"b04b3dd0d2291dbad09ed9929f0917ee17f113d7ce4aa4a560e65860a687d83d","superscripts":0}],"text":"【6】  を  と対応させ、和と積の条件を書こう。［　　　　　　　　　　　　　　　　］"},{"extractionStatus":"PASS","id":"word-p-000674","images":[],"kind":"question","locator":"word/document.xml:p[674]","markers":[7],"math":[],"mathStructures":[],"text":"【7】 正の二数を求め、候補となる平方根の差を書こう。［　　　　　　　　　　　　　　　　］"},{"extractionStatus":"PASS","id":"word-p-000675","images":[],"kind":"explanation","locator":"word/document.xml:p[675]","markers":[],"math":[],"mathStructures":[],"text":"花子　「平方が合う候補が二つあっても、根号そのものは非負の方を表すんだったね。」"},{"extractionStatus":"PASS","id":"word-p-000676","images":[],"kind":"question","locator":"word/document.xml:p[676]","markers":[8],"math":[],"mathStructures":[],"text":"【8】 符号を比較し、元の根号の値を選ぼう。［　　　　　　　　　　　　　　　　］"},{"extractionStatus":"PASS","id":"word-p-000677","images":[],"kind":"explanation","locator":"word/document.xml:p[677]","markers":[],"math":[],"mathStructures":[],"text":"差の形では、平方だけでなく大小を確かめて非負の方を選ぶ。一般には、差の絶対値として表せる。"},{"extractionStatus":"PASS","id":"word-p-000678","images":[],"kind":"explanation","locator":"word/document.xml:p[678]","markers":[],"math":[],"mathStructures":[],"text":"中央の係数が2でない形をそろえる"},{"extractionStatus":"PASS","id":"word-p-000679","images":[],"kind":"explanation","locator":"word/document.xml:p[679]","markers":[],"math":[],"mathStructures":[],"text":"確認"},{"extractionStatus":"PASS","id":"word-p-000680","images":[],"kind":"explanation","locator":"word/document.xml:p[680]","markers":[],"math":[{"display":"InlineMath","latex":"\\sqrt{3 + \\sqrt{5}}"}],"mathStructures":[{"fractions":0,"radicals":2,"sha256":"cce31c9b929847878460e0dfb8df1d8ea69aaeb06b359bc6827a2bbd574ffe4f","superscripts":0}],"text":" を簡単にしよう。根号内を分母2の一つの分数に直すと、前と同じ中央の係数を作れる。"},{"extractionStatus":"PASS","id":"word-p-000681","images":[],"kind":"question","locator":"word/document.xml:p[681]","markers":[9],"math":[],"mathStructures":[],"text":"【9】 根号内を、分母が2の分数で書こう。［　　　　　　　　　　　　　　　　］"},{"extractionStatus":"PASS","id":"word-p-000682","images":[],"kind":"question","locator":"word/document.xml:p[682]","markers":[10],"math":[],"mathStructures":[],"text":"【10】 平方根の商の関係を使い、分子と分母を分けよう。［　　　　　　　　　　　　　　　　］"},{"extractionStatus":"PASS","id":"word-p-000683","images":[],"kind":"question","locator":"word/document.xml:p[683]","markers":[11],"math":[],"mathStructures":[],"text":"【11】 分子について和と積の条件を作り、二重根号を外そう。［　　　　　　　　　　　　　　　　］"},{"extractionStatus":"PASS","id":"word-p-000684","images":[],"kind":"question","locator":"word/document.xml:p[684]","markers":[12],"math":[],"mathStructures":[],"text":"【12】 全体の分母を有理化し、答えをまとめよう。［　　　　　　　　　　　　　　　　］"},{"extractionStatus":"PASS","id":"word-p-000685","images":[],"kind":"explanation","locator":"word/document.xml:p[685]","markers":[],"math":[],"mathStructures":[],"text":"ここで扱ったのは、根号内を平方の展開と対応させられる場合である。手順は、和と積の条件を作ること、候補を見つけること、最後に符号まで確かめることである。"}],"status":"NEEDS_AI_REVIEW"}
