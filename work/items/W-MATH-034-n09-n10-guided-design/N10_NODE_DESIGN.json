      "resultId": "n10-02-result",
      "requires": [
        "n10-q02-sign-result"
      ],
      "knownRefs": [],
      "resolvedFormula": "\\sqrt{125}=5\\sqrt5"
    },
    {
      "id": "n10-q03-expand",
      "unit": "n10",
      "stageId": "n10-stage-02",
      "goal": "積を平方して因子をまとめる",
      "before": "ここからは **証明** です。条件は $a>0,b>0$。$(\\sqrt a\\sqrt b)^2$ を同じ積の2回の掛け算と読み、実数の積の交換・結合で同じ因子をまとめます。",
      "formula": "(\\sqrt a\\sqrt b)^2=\\square",
      "answer": "(\\sqrt a)^2(\\sqrt b)^2",
      "wrong": [
        [
          "(\\sqrt a)^2+(\\sqrt b)^2",
          "元は和ではなく積です。"
        ],
        [
          "\\sqrt a(\\sqrt b)^2",
          "どちらの因子も2回ずつ現れます。"
        ]
      ],
      "after": "各因子の平方には平方根の定義を使えます。",
      "hint": "同じ因子を二つずつ集めます。",
      "sourceRefs": [
        "word-p-000424",
        "word-p-000425",
        "word-p-000426"
      ],
      "action": "expression",
      "role": "proof",
      "itemId": "n10-q03-expand",
      "anchor": false,
      "extra": {},
      "known": [],
      "resultId": "n10-q03-expand-result",
      "requires": [
        "n10-02-result"
      ],
      "knownRefs": [
        "n10-02-result"
      ],
      "resolvedFormula": "(\\sqrt a\\sqrt b)^2=(\\sqrt a)^2(\\sqrt b)^2"
    },
    {
      "id": "n10-03",
      "unit": "n10",
      "stageId": "n10-stage-02",
      "goal": "定義から積の平方を求める",
      "before": "$(\\sqrt a)^2=a$、$(\\sqrt b)^2=b$ を、いまの積へそれぞれ戻します。",
      "formula": "(\\sqrt a\\sqrt b)^2=\\square",
      "answer": "ab",
      "wrong": [
        [
          "a+b",
          "定義を代入しても、因子どうしの積は残ります。"
        ],
        [
          "\\sqrt{ab}",
          "平方した後の値と元の根号を区別します。"
        ],
        [
          "a^2b^2",
          "平方根の平方は中身に戻ります。"
        ]
      ],
      "after": "積の平方がabであることが分かりました。符号の確認がまだ必要です。",
      "hint": "二つの因子を、それぞれ定義どおり置き換えます。",
      "sourceRefs": [
        "word-p-000426"
