      "resultId": "n10-q02-sign-result",
      "requires": [
        "n10-01-result"
      ],
      "knownRefs": [],
      "resolvedFormula": "t=5"
    },
    {
      "id": "n10-02",
      "unit": "n10",
      "stageId": "n10-stage-01",
      "goal": "候補へ代入して平方根を確定する",
      "before": "候補は $t\\sqrt5$ でした。求めた正のtを代入します。候補は正で、平方すると125なので、125の正の平方根と等しいと確定できます。",
      "formula": "\\sqrt{125}=\\square",
      "answer": "5\\sqrt5",
      "wrong": [
        [
          "-5\\sqrt5",
          "正の平方根を表す符号を選びます。"
        ],
        [
          "25\\sqrt5",
          "tの平方ではなくt自身を代入します。"
        ],
        [
          "5\\sqrt{25}",
          "候補で残した根号の中身は5です。"
        ]
      ],
      "after": "平方の値と正の符号を確認した、この手順を一般の積・商へ広げます。",
      "hint": "候補の文字tの位置だけを置き換えます。",
      "sourceRefs": [
        "word-p-000422",
        "word-p-000423"
      ],
      "action": "expression",
      "role": "substep",
      "itemId": "n10-02",
      "anchor": true,
