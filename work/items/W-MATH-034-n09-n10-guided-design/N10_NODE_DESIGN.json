  "nodes": [
    {
      "id": "n10-q01-square",
      "unit": "n10",
      "stageId": "n10-stage-01",
      "goal": "候補の平方を計算する",
      "before": "根号は非負の値を表し、2乗すると中の数に戻ることを使います。例題は $\\sqrt{125}$ を、根号の中の数が小さい形に表すことです。$125=25\\cdot5$ なので、$t>0$ として候補 $t\\sqrt5$ を調べます。積の平方は各因子の平方の積です。ここではまだ根号の積の公式を使いません。",
      "formula": "(t\\sqrt5)^2=t^2(\\sqrt5)^2=\\square",
      "answer": "5t^2",
      "wrong": [
        [
          "5t",
          "tも2乗されます。"
        ],
        [
          "25t^2",
          "根号を2乗した値を確認します。"
        ]
      ],
      "after": "元の正の平方根と等しいために、候補の平方は125である必要があります。",
      "hint": "平方根の定義から(√5)²を求めます。",
      "sourceRefs": [
        "word-p-000419",
        "word-p-000420",
        "word-p-000421"
      ],
      "action": "expression",
      "role": "example",
      "itemId": "n10-q01-square",
      "anchor": false,
      "extra": {},
      "known": [],
      "resultId": "n10-q01-square-result",
      "requires": [],
      "knownRefs": [],
      "resolvedFormula": "(t\\sqrt5)^2=t^2(\\sqrt5)^2=5t^2"
    },
    {
      "id": "n10-01",
      "unit": "n10",
      "stageId": "n10-stage-01",
      "goal": "同じ数で割ってtの平方を取り出す",
      "before": "$5t^2=125$ の両辺を5で割ります。左の係数を1にして、右辺も同じ操作で計算します。",
      "formula": "\\square",
      "answer": "t^2=25",
      "wrong": [
        [
          "t=25",
          "2乗されているtを、そのままtに変えません。"
        ],
        [
          "t^2=125",
          "左辺を5で割ったら右辺も5で割ります。"
        ],
        [
          "t^2=5",
          "125を5で割る計算を確かめます。"
        ]
      ],
      "after": "tの平方が求まりました。次は最初に置いた正の条件を使います。",
      "hint": "左の係数を1にする操作を両辺に行います。",
      "sourceRefs": [
        "word-p-000421"
      ],
      "action": "expression",
      "role": "substep",
      "itemId": "n10-01",
      "anchor": true,
      "extra": {},
      "known": [],
      "resultId": "n10-01-result",
      "requires": [
        "n10-q01-square-result"
      ],
      "knownRefs": [],
      "resolvedFormula": "t^2=25"
    },
    {
      "id": "n10-q02-sign",
      "unit": "n10",
      "stageId": "n10-stage-01",
      "goal": "正の条件で候補を一つに絞る",
      "before": "$t^2=25$ では符号が反対の二つの実数が候補になります。最初の条件 $t>0$ も満たす方を選びます。",
      "formula": "t=\\square",
      "answer": "5",
      "wrong": [
        [
          "-5",
          "最初の正の条件に戻ります。"
        ],
        [
          "\\pm5",
          "正の条件を使うと一つに決まります。"
        ]
      ],
      "after": "このtを候補の式へ戻します。",
      "hint": "平方の条件と符号の条件を両方使います。",
      "sourceRefs": [
        "word-p-000422"
      ],
      "action": "judgment",
      "role": "substep",
      "itemId": "n10-q02-sign",
