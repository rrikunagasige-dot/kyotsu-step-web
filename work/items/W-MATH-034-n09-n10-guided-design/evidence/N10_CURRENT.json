          {
            "id": "marker-sum-example",
            "type": "marker",
            "kind": "example",
            "text": "例題"
          },
          {
            "id": "paragraph-sum-intro",
            "type": "paragraph",
            "parts": [
              {
                "type": "math",
                "latex": "\\sqrt8+\\sqrt{50}"
              },
              {
                "type": "text",
                "text": " を考えよう。いま扱っているのは積ではなく"
              },
              {
                "type": "term",
                "text": "和"
              },
              {
                "type": "text",
                "text": "である。積の法則をそのまま足し算へ移さず、それぞれの項を簡単にしてみよう。"
              }
            ]
          },
          {
            "id": "formula-n10-09",
            "type": "formula",
            "parts": [
              {
                "type": "math",
                "latex": "\\sqrt8+\\sqrt{50}="
              },
              {
                "type": "choice",
                "itemId": "n10-09"
              }
            ],
            "derivationId": "root-sum"
          },
          {
            "id": "formula-n10-10",
            "type": "formula",
            "parts": [
              {
                "type": "math",
                "latex": "="
