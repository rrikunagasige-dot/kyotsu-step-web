              },
              {
                "type": "text",
                "text": "。"
              }
            ]
          },
          {
            "id": "paragraph-rationalize-multiplier",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "分母の "
              },
              {
                "type": "math",
                "latex": "\\sqrt3"
              },
              {
                "type": "text",
                "text": " と掛けて平方数を作る因子を選ぼう。"
              }
            ]
          },
          {
            "id": "formula-n10-15",
            "type": "formula",
            "parts": [
              {
                "type": "math",
                "latex": "\\frac1{2\\sqrt3}="
