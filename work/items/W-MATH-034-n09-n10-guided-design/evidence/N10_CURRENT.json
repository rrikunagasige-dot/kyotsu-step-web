          },
          {
            "id": "paragraph-square-intro",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "乗法公式も、根号を含む数に使える。"
              },
              {
                "type": "math",
                "latex": "(\\sqrt2-\\sqrt3)^2"
              },
              {
                "type": "text",
                "text": " をまず平方の公式で展開すると、"
              }
            ]
          },
          {
            "id": "formula-n10-11",
            "type": "formula",
            "parts": [
              {
                "type": "math",
                "latex": "(\\sqrt2-\\sqrt3)^2="
              },
              {
                "type": "choice",
                "itemId": "n10-11"
              }
            ],
            "derivationId": "root-square"
          },
          {
            "id": "formula-n10-12",
            "type": "formula",
            "parts": [
              {
                "type": "math",
