      ],
      "knownRefs": [],
      "resolvedFormula": "(\\sqrt a+\\sqrt b)^2=(\\sqrt a)^2+\\sqrt a\\sqrt b+\\sqrt b\\sqrt a+(\\sqrt b)^2"
    },
    {
