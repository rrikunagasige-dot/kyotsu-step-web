      "interaction": null,
      "before": [
        {
          "id": "n08-q01-right-before",
          "text": "図の右側にある $2.3$ の点を見ます。原点の座標は $0$ です。右側の座標から左側の座標を引き、距離を求めます。"
        }
      ],
      "after": [
        {
          "id": "n08-q01-right-after",
          "text": "$2.3-0=2.3$ です。右側の点は原点から $2.3$ 離れています。次は左側の点を同じ方法で見ます。"
        }
      ]
