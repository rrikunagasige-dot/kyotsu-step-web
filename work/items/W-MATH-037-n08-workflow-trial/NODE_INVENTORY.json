      ],
      "after": [
        {
          "id": "n08-q03-order-result",
          "text": "$|a|$$=$$0-a$"
        },
        {
          "id": "n08-q03-order-after",
          "text": "条件 $a<0$ の場合の結論です。次は、この引き算を一つの項にします。"
        }
      ],
      "question": "左側の点の距離を引き算で作る",
      "answer": "0-a",
      "choices": [
        "0-a",
        "a-0",
        "0+a"
      ],
      "hints": [
        "数直線で、二点の右と左を先に決めます。"
