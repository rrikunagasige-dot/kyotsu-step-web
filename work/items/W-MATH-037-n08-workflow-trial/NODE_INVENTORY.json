    {
      "id": "n08-definition",
      "stageId": "n08-stage-02",
      "q": 2,
      "goal": "この距離を絶対値と名付ける",
      "role": "definition",
      "knownRefs": [
        "n08-01-result"
      ],
      "resultId": "n08-definition-result",
      "interaction": null,
      "before": [
        {
          "id": "n08-definition-before",
          "text": "実数 $a$ を表す点と原点との距離を、絶対値といい、$|a|$ と書きます。縦の二本の線は、中にある式全体について距離を取る記号です。"
        }
      ],
      "after": [
        {
          "id": "n08-definition-after",
          "text": "未知の名前を当てさせず、ここで定義します。次に、座標の正負に応じてこの距離を式にします。"
        }
      ]
    },
    {
      "id": "n08-02",
      "stageId": "n08-stage-02",
      "q": 2,
      "goal": "原点か右側なら座標が距離になる",
      "role": "substep",
      "knownRefs": [],
      "resultId": "n08-02-result",
      "interaction": "n08-02",
      "before": [
        {
          "id": "n08-02-before",
          "text": "$a\\ge0$ の場合を考えます。点は原点か右側にあるので、右の座標 $a$ から左の座標 $0$ を引きます。$a-0=a$ を絶対値の記号でまとめます。"
        },
        {
          "id": "n08-02-interaction-0",
          "text": "[n08-02]"
        }
      ],
      "after": [
        {
          "id": "n08-02-result",
          "text": "$|a|$$=$$a$"
        },
        {
          "id": "n08-02-after",
          "text": "条件 $a\\ge0$ の場合の結論です。$a=0$ の場合も含みます。左側の場合も調べれば、すべての実数を扱えます。"
        }
      ],
      "question": "原点か右側なら座標が距離になる",
      "answer": "|a|=a",
      "choices": [
        "|a|=a",
        "|a|=-a",
        "|a|=0",
        "|a|=a^2"
      ],
      "hints": [
        "場合の条件と、左右の座標を確かめます。"
      ]
    },
    {
      "id": "n08-q03-order",
