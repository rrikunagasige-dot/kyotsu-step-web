    {
      "id": "n08-03",
      "stageId": "n08-stage-03",
      "q": 3,
      "goal": "左側の距離を簡単にする",
      "role": "substep",
      "knownRefs": [],
      "resultId": "n08-03-result",
      "interaction": "n08-03",
      "before": [
        {
          "id": "n08-03-before",
          "text": "先ほど作った $0-a$ では、$0$ から $a$ を引いています。$a$ と符号が反対の数になるので、等式を完成させます。"
