        34
      ]
    },
    "title": "距離の条件を、二つの位置へ戻す",
    "subtitle": "絶対値方程式を左右二つの位置と「または」で解く。",
    "source": {
      "type": "reference",
      "label": "ユーザー提供「数と式」教科書モード対話段階導入版 v2 / N13",
      "rightsNote": "教師編集WordのN13原問9件と元の距離図2点を使用。独立解答、公式別冊未提供、レビュー限定。"
    },
    "objectives": [
      "絶対値方程式を左右二つの式へ分ける",
      "平行移動した中心からの距離を読む",
      "距離が0・負の場合を区別する"
    ],
    "sections": [
      {
        "id": "lesson",
        "number": "13",
        "title": "本文",
        "description": "距離の意味を保ったまま二つの方程式へ変形する。",
        "role": "concept",
        "figures": [
          {
            "id": "n13-f02",
            "src": "/assets/math/textbook/numbers/n13-f02.png",
            "alt": "原点から左右に同じ距離の二点を示す、解答後確認用の元数直線。",
            "caption": "左右の位置と等しい距離を検算する。",
            "overlays": []
          },
          {
            "id": "n13-f01",
            "src": "/assets/math/textbook/numbers/n13-f01.png",
            "alt": "点xが1の右側にある場合と左側にある場合の元図。",
            "caption": "中心1からの距離を、引き算の順として考えよう。",
            "overlays": []
          }
        ],
        "readingFlow": [
          {
            "id": "n13-heading-1",
            "type": "heading",
            "text": "距離を満たす二つの位置"
          },
          {
            "id": "n13-marker-1",
            "type": "marker",
            "kind": "example",
            "text": "例題"
          },
          {
            "id": "n13-group-1",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "絶対値は数直線上の距離を表す。距離が正であれば原点の左右に同じ距離の点が一つずつある。「または」で二つの位置を表す。"
              }
            ]
          },
          {
            "id": "n13-lead-01",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "|x|=5は原点から5離れた点の条件。左右どちらも調べる。"
              },
              {
                "type": "math",
                "latex": "|x|=5"
              }
            ]
          },
          {
            "id": "n13-formula-01",
            "type": "formula",
            "parts": [
              {
                "type": "choice",
                "itemId": "n13-01"
              }
            ]
          },
          {
            "id": "n13-after-01",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "「または」はどちらか一方を満たせばよい条件で、両方を同時に満たす意味ではない。"
              }
            ]
          },
          {
            "id": "n13-show-n13-f02",
            "type": "figure",
            "figureId": "n13-f02"
          },
          {
            "id": "n13-lead-02",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "|x−1|=4では中のx−1全体をXと置く。さきほどの距離4の条件をXに使う。"
              },
              {
                "type": "math",
                "latex": "X=x-1,\\quad|X|=4"
              }
            ]
          },
          {
            "id": "n13-formula-02",
            "type": "formula",
            "parts": [
              {
                "type": "choice",
                "itemId": "n13-02"
              }
            ]
          },
          {
            "id": "n13-after-02",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "中身をひとまとまりにしたまま、距離の条件を方程式へ戻せた。"
              }
            ]
          },
          {
            "id": "n13-lead-03",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "仮の文字Xを元のx−1に置き換え、二つの普通の方程式にする。"
              },
              {
                "type": "math",
                "latex": "X=x-1"
              }
            ]
          },
          {
            "id": "n13-formula-03",
            "type": "formula",
            "parts": [
              {
                "type": "choice",
                "itemId": "n13-03"
              }
            ]
          },
          {
            "id": "n13-after-03",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "二本の式をそれぞれ解けば、元の絶対値方程式の候補が揃う。"
              }
            ]
          },
          {
            "id": "n13-lead-04",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "x−1=4とx−1=−4のそれぞれで、両辺へ1を足す。"
              },
              {
                "type": "math",
                "latex": "|x-1|=4"
              }
            ]
          },
          {
            "id": "n13-formula-04",
            "type": "formula",
            "parts": [
              {
                "type": "choice",
                "itemId": "n13-04"
              }
            ]
          },
          {
            "id": "n13-after-04",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "二つの点は1を中心として左右に同じ4だけ離れている。"
              }
            ]
          },
          {
            "id": "n13-show-n13-f01",
            "type": "figure",
            "figureId": "n13-f01"
          },
          {
            "id": "n13-heading-2",
            "type": "heading",
            "text": "中心を移しても距離は同じ"
          },
          {
            "id": "n13-marker-2",
            "type": "marker",
            "kind": "check",
            "text": "確認"
          },
          {
            "id": "n13-group-2",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "|x−1|は点xと点1の間の距離。xが1の右側か左側かによって、引き算の順を変える。"
              }
            ]
          },
          {
            "id": "n13-lead-05",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "|x−1| は点 x と点 1 の距離。数直線でどちらが右にあるかを先に見て、右の座標から左の座標を引こう。"
              }
            ],
            "derivationId": "n13-q05-chain"
          },
          {
            "id": "n13-wm023-q05-right",
            "type": "formula",
            "parts": [
              {
                "type": "math",
                "latex": "x\\ge1:\\quad |x-1|="
              },
              {
                "type": "choice",
                "itemId": "n13-wm023-q05-right"
              }
            ],
            "derivationId": "n13-q05-chain"
          },
          {
            "id": "n13-formula-05",
            "type": "formula",
            "parts": [
              {
                "type": "math",
                "latex": "x<1:\\quad |x-1|="
              },
              {
                "type": "choice",
                "itemId": "n13-05"
              }
            ],
            "derivationId": "n13-q05-chain"
          },
          {
            "id": "n13-after-05",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "x≥1ならx−1≥0、x<1なら1−x>0。どちらも二点間の距離として負にならない。"
              }
            ]
          },
          {
            "id": "n13-heading-3",
            "type": "heading",
            "text": "中の式を一つの数として扱う"
          },
          {
            "id": "n13-marker-3",
            "type": "marker",
            "kind": "check",
            "text": "確認"
          },
          {
            "id": "n13-group-3",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "別の式でも距離の二分岐がそのまま使える。右辺が0や負のときは、距離として可能かどうかを先に確かめる。"
              }
            ]
          },
          {
            "id": "n13-lead-06",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "|x+2|=3を解く。中身のx+2を、原点から距離3の一つの数と見よう。"
              },
              {
                "type": "math",
                "latex": "|x+2|=3"
              }
            ]
          },
          {
            "id": "n13-formula-06",
            "type": "formula",
            "parts": [
              {
                "type": "choice",
                "itemId": "n13-06"
              }
            ]
          },
          {
            "id": "n13-after-06",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "二つの方程式を解くとき、+2を両方の枝から引く。"
              }
            ]
          },
          {
            "id": "n13-lead-07",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "x+2=3とx+2=−3をそれぞれ解く。"
              },
              {
                "type": "math",
                "latex": "|x+2|=3"
              }
            ]
          },
          {
            "id": "n13-formula-07",
            "type": "formula",
            "parts": [
              {
                "type": "choice",
                "itemId": "n13-07"
              }
            ]
          },
          {
            "id": "n13-after-07",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "二つの解は−2を中心に左右へ3ずつ離れた位置にある。"
              }
            ]
          },
          {
            "id": "n13-lead-08",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "|3x|=6 では、はじめに絶対値の中身がとり得る二通りの等式を作り、それぞれを x について解こう。"
              },
              {
                "type": "math",
                "latex": "|3x|=6"
              }
            ],
            "derivationId": "n13-q08-chain"
          },
          {
            "id": "n13-formula-08",
            "type": "formula",
            "parts": [
              {
                "type": "choice",
                "itemId": "n13-wm023-q08-branches"
              }
            ],
            "derivationId": "n13-q08-chain"
          },
          {
            "id": "n13-wm023-q08-positive-root",
            "type": "formula",
            "parts": [
              {
                "type": "math",
                "latex": "3x=6\\Rightarrow x="
              },
              {
                "type": "choice",
                "itemId": "n13-wm023-q08-positive-root"
              }
            ],
            "derivationId": "n13-q08-chain"
          },
          {
            "id": "n13-wm023-q08-negative-root",
            "type": "formula",
            "parts": [
              {
                "type": "math",
                "latex": "3x=-6\\Rightarrow x="
              },
              {
                "type": "choice",
                "itemId": "n13-08"
              }
            ],
            "derivationId": "n13-q08-chain"
          },
          {
            "id": "n13-after-08",
            "type": "paragraph",
            "parts": [
              {
                "type": "math",
                "latex": "x=2\\;\\text{または}\\;x=-2"
              },
              {
                "type": "text",
                "text": "。二つの解は「または」で結ぶ。両方の条件を同時に満たすという意味ではない。"
              }
            ]
          },
          {
            "id": "n13-lead-09",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "絶対値は負にならない。距離が0の場合と負の値を要求される場合を比べる。"
              },
              {
                "type": "math",
                "latex": "|x|=0,\\quad|x|=-2"
              }
            ]
          },
          {
            "id": "n13-formula-09",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "考えて選ぶ："
              },
              {
                "type": "choice",
                "itemId": "n13-09"
              }
            ]
          },
          {
            "id": "n13-after-09",
            "type": "paragraph",
            "parts": [
              {
                "type": "text",
                "text": "|X|=aでは、a>0なら二枝、a=0なら一つ、a<0なら実数解なし。次は距離に上限・下限を付ける。"
              }
            ]
          }
        ],
        "items": [
